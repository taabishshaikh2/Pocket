MONGODB_URI=mongodb://127.0.0.1:27017/pocket
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
# Set to 1 only when your production host has exactly one trusted reverse proxy.
TRUST_PROXY=0

# Separate Render client/API hosting: set true only with production HTTPS.
CROSS_SITE_COOKIES=false
# Set false for an API-only Render Web Service.
SERVE_CLIENT=true
# Public frontend build setting. Blank uses the local Vite proxy. No /api suffix.
VITE_API_URL=

# Promotes this existing account to admin during server startup.
ADMIN_EMAIL=taabishshaikh2@gmail.com

# Frontend gateway only: fixed backend origin. Run with npm run start:client.
API_PROXY_TARGET=https://pocketbackend.onrender.com
